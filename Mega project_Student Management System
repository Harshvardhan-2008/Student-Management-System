import json
print("===== STUDENT MANAGEMENT SYSTEM =====")

class Student:
    def __init__(self,student_id,name,marks_list):
        self.student_id =student_id
        self.name=name
        self.marks_list=marks_list
        
    def total_marks(self):
        total=0
        total =total+ self.marks_list[0]+ self.marks_list[1]+ self.marks_list[2]
        return total
        
    def percentage(self):
        
        return (self.total_marks() / 300) * 100
    
    def grade(self):
        per=self.percentage()
        if per >= 90:
            return "A+"
        elif per >= 80:
            return "A"
        elif per >= 70:
            return "B"
        elif per >= 60:
            return "C"
        elif per >= 40:
            return "D"
        else:
            return "Fail"
        
    
    def to_dict(self):
        return {
            "student_id": self.student_id,
            "name": self.name,
            "marks_list": self.marks_list
        }
        
    
def save_students():
    student_data = []   
    for student in students:
        student_data.append(student.to_dict())
    
    with open("students.json","w") as f:
        json.dump(student_data,f,indent=4)
    print("Student records saved successfully!")
    

def load_students():
    students_data = []

    try:
        with open("students.json", "r") as f:
            students_data = json.load(f)
    except FileNotFoundError:
        return []

    loaded_students = []

    for data in students_data:
        student = Student(
            data["student_id"],
            data["name"],
            data["marks_list"]
        )
        loaded_students.append(student)

    return loaded_students

